flowchart TB
  accTitle: launch.json 的远程调试关键配置
  accDescr: VS Code 使用 Python Debugger 扩展；其他编辑器先确认扩展兼容。远程附加配置指定 debugpy、attach 和 127.0.0.1:5678；pathMappings 将本地工作目录映射到服务器上的真实代码目录，以正确对应断点。
  config[".vscode/launch.json<br/>VS Code Python Debugger"]
  subgraph connection["连接调试服务"]
    direction TB
    adapter["调试配置<br/>name: Python: Remote Attach<br/>type: debugpy · request: attach"]
    target["connect<br/>host: 127.0.0.1 · port: 5678"]
    tunnel["SSH 端口转发<br/>本地 5678 → 服务器 5678"]
    adapter --> target --> tunnel
  end
  subgraph paths["对应本地与服务器文件"]
    direction TB
    mapping["pathMappings<br/>对应同一份代码<br/>的本地与服务器路径"]
    localPath["localRoot<br/>${workspaceFolder}"]
    remotePath["remoteRoot<br/>/path/to/your/code/on/server"]
    mapping --- localPath
    localPath <-->|"同一份代码"| remotePath
  end
  config --> connection
  config --> paths
