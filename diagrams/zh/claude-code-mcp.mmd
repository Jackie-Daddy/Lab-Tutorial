flowchart TB
  accTitle: Claude Code 连接官方 GitHub MCP
  accDescr: 项目 .mcp.json 配置 GitHub HTTP 服务；令牌通过环境变量提供。Claude Code 连接后按权限读取仓库或执行已授权操作，其他 MCP 服务器需要单独核对维护者和接口。

config["项目配置 .mcp.json<br/>GitHub HTTP MCP"]
  token["环境变量 GITHUB_PAT<br/>按需授予仓库权限"]
  claude["Claude Code<br/>用 /mcp 检查连接"]
  server["官方 GitHub MCP<br/>api.githubcopilot.com/mcp/"]
  read["读取仓库与 Issue<br/>收集任务上下文"]
  write["创建 PR 等写入操作<br/>核对权限与用户授权"]
  config --> claude
  token --> claude
  claude --> server
  server --> read
  server --> write
