flowchart TB
  accTitle: Create side-by-side panes and a status bar with KDL
  accDescr: The editor tab has a vertical container holding Yazi and a shell side by side, followed by a status bar below. Start with zellij --layout dev.

file["~/.config/zellij/layouts/dev.kdl"]
  start["zellij --layout dev"]
  tab["Tab: editor"]
  split["Vertical container<br/>Two side-by-side panes"]
  yazi["Yazi pane<br/>Install yazi first"]
  shell["Shell pane"]
  status["Bottom status bar<br/>zellij:status-bar, height 1"]
  file --> start --> tab
  tab --> split
  split --> yazi
  split --> shell
  tab --> status
