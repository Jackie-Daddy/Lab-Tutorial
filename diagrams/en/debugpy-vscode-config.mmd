flowchart TB
  accTitle: Key Remote Attach Settings in launch.json
  accDescr: VS Code requires Python Debugger; other editors need compatible extensions. Remote attach selects debugpy, attach, and 127.0.0.1:5678. The pathMappings setting matches the local workspace with the actual server code directory so breakpoints refer to the correct files.
  config[".vscode/launch.json<br/>VS Code Python Debugger"]
  subgraph connection["Connect to the debug server"]
    direction TB
    adapter["Debug configuration<br/>name: Python: Remote Attach<br/>type: debugpy · request: attach"]
    target["connect<br/>host: 127.0.0.1 · port: 5678"]
    tunnel["SSH port forwarding<br/>Local 5678 → server 5678"]
    adapter --> target --> tunnel
  end
  subgraph paths["Match local and remote files"]
    direction TB
    mapping["pathMappings<br/>Match paths for the same source code"]
    localPath["localRoot<br/>${workspaceFolder}"]
    remotePath["remoteRoot<br/>/path/to/your/code/on/server"]
    mapping --- localPath
    localPath <-->|"Same source code"| remotePath
  end
  config --> connection
  config --> paths
