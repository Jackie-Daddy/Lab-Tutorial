  cache["Refresh the font cache on Linux<br/>fc-cache -fv"]
  choose["Select this font in terminal settings<br/>JetBrainsMono Nerd Font Mono"]
  terminal["Terminal application<br/>Update its font setting"]
  vscode["VS Code integrated terminal<br/>Set terminal.integrated.fontFamily"]
  icons["After installing and selecting the font<br/>Folder and file-type icons render correctly"]
