<% var lang = page.lang || 'zh'; %>
<% var filteredPosts = site.posts.filter(function(p) { return p.lang === lang; }).sort('date', -1); %>

<div class="page-heading">
  <h1><%- __('archive.title') %></h1>
  <p style="color:var(--c-mid);font-size:0.9rem"><%- __('archive.total', filteredPosts.length) %></p>
</div>

<% var currentYear = ''; %>
<% filteredPosts.each(function(post){ %>
  <% var year = date(post.date, 'YYYY'); %>
  <% if (year !== currentYear) { %>
    <% currentYear = year; %>
    <h2 class="archive-year"><%= year %></h2>
  <% } %>
  <div class="archive-post">
    <span class="archive-post-date"><%- date(post.date, 'MM-DD') %></span>
    <span class="archive-post-title">
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
    </span>
  </div>
<% }) %>
