<% var lang = (page.lang === 'en') ? 'en' : 'zh'; %>
<% var switchLang = (lang === 'zh') ? 'en' : 'zh'; %>
<% var switchPath = page.path ? page.path.replace(/^(zh|en)\//, switchLang + '/') : '/' + switchLang + '/'; %>
<header class="site-header">
  <div class="nav-inner">
    <a class="nav-brand" href="<%- url_for('/' + lang + '/') %>">
      <span class="dot"></span>
      <%- config.title %>
    </a>
    <nav>
      <ul class="nav-links">
        <li><a href="<%- url_for('/' + lang + '/archives/') %>"><%- __('nav.archives') %></a></li>
        <li><a href="<%- url_for('/about/') %>"><%- __('nav.about') %></a></li>
        <li>
          <a class="lang-switch" href="<%- url_for(switchPath) %>"><%- __('nav.lang_toggle') %></a>
        </li>
      </ul>
    </nav>
  </div>
</header>
