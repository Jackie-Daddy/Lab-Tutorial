<% var currentLang = page.lang || site.config.language || 'zh-CN'; %>
<header class="site-header">
  <div class="nav-inner">
    <a class="nav-brand" href="<%- url_for(currentLang === 'zh-CN' || currentLang === 'zh' ? '/zh/' : '/en/') %>">
      <span class="dot"></span>
      <%- config.title %>
    </a>
    <nav>
      <ul class="nav-links">
        <% var menu = theme.menu || {}; %>
        <% for (var key in menu) { %>
          <li><a href="<%- url_for(menu[key]) %>"><%- __('nav.' + key.toLowerCase()) %></a></li>
        <% } %>
        <li>
          <% if (currentLang === 'zh' || currentLang === 'zh-CN') { %>
            <a class="lang-switch" href="<%- url_for('/en/') %>"><%- __('nav.lang_toggle') %></a>
          <% } else { %>
            <a class="lang-switch" href="<%- url_for('/zh/') %>"><%- __('nav.lang_toggle') %></a>
          <% } %>
        </li>
      </ul>
    </nav>
  </div>
</header>
