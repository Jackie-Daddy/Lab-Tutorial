<% if (page.prev || page.next) { %>
  <nav class="pagination">
    <% if (page.prev) { %>
      <a href="<%- url_for(page.prev_link) %>">&larr; <%- __('post.prev') %></a>
    <% } else { %>
      <span></span>
    <% } %>
    <span class="page-number"><%= page.current %> / <%= page.total %></span>
    <% if (page.next) { %>
      <a href="<%- url_for(page.next_link) %>"><%- __('post.next') %> &rarr;</a>
    <% } else { %>
      <span></span>
    <% } %>
  </nav>
<% } %>
