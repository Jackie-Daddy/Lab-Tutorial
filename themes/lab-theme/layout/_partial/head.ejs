<!DOCTYPE html>
<html lang="<%= config.language === 'zh-CN' ? 'zh-CN' : 'en' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% if (page.title) { %>
    <title><%= page.title %> | <%= config.title %></title>
  <% } else { %>
    <title><%= config.title %></title>
  <% } %>

  <% if (page.description) { %>
    <meta name="description" content="<%= page.description %>">
  <% } else if (config.description) { %>
    <meta name="description" content="<%= config.description %>">
  <% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,600;1,400&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">

  <%- css('css/style') %>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='16' fill='%23141413'/><circle cx='16' cy='16' r='6' fill='%23d97757'/></svg>">

  <%- open_graph({}) %>
</head>
