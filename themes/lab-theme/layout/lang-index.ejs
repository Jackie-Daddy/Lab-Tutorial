<% var lang = page.lang || 'zh'; %>
<% var filteredPosts = site.posts.filter(function(p) { return p.lang === lang; }).sort('date', -1); %>

<% if (filteredPosts.length === 0) { %>
  <p style="text-align:center;color:var(--c-mid);padding:3rem 0"><%- __('not_found.message') %></p>
<% } else { %>
<ul class="post-list">
  <% filteredPosts.each(function(post){ %>
    <li class="post-card">
      <div class="post-card-meta">
        <span class="accent-dot"></span>
        <%- date(post.date, 'YYYY-MM-DD') %>
        <% if (post.categories && post.categories.length) { %>
          · <%= post.categories.map(function(c){ return c.name; }).join(', ') %>
        <% } %>
      </div>
      <h2 class="post-card-title">
        <a href="<%- url_for(post.path) %>"><%= post.title || '(untitled)' %></a>
      </h2>
      <% if (post.excerpt) { %>
        <div class="post-card-excerpt">
          <%- post.excerpt %>
        </div>
      <% } %>
      <% if (post.tags && post.tags.length) { %>
        <div class="post-card-tags">
          <% post.tags.each(function(tag){ %>
            <a href="<%- url_for(tag.path) %>"><%= tag.name %></a>
          <% }) %>
        </div>
      <% } %>
      <a class="post-card-readmore" href="<%- url_for(post.path) %>"><%- __('post.read_more') %> →</a>
    </li>
  <% }) %>
</ul>

<% if (filteredPosts.length > 10) { %>
  <%- partial('_partial/pagination') %>
<% } %>
<% } %>
